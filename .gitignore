# Repo-wide ignores. Per-app ignores live in engine/.gitignore and web/.gitignore.

# Local environment / secrets — never commit
.env
.env.local
*.local

# PostgreSQL data volume + backups (see Deployment plan)
data/

# Node (root tooling — husky/commitlint)
node_modules/

# Python
__pycache__/
*.py[cod]

# OS / editor
.DS_Store
*.log

# Claude Code local session state — entirely ignored.
# Skills are sourced from the My-Skills plugin marketplace (see AGENTS.md),
# not vendored in this repo, so there is nothing in .claude/ worth tracking.
.claude/
